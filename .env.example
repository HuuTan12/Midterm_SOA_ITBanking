# Copy file này thành .env rồi đổi các giá trị "changeme"
# Lệnh: Copy-Item .env.example .env
# Mật khẩu không nên có ký tự đặc biệt như @ / : vì được dùng trong URL kết nối

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

JWT_SECRET=changeme
INTERNAL_API_KEY=changeme

# Gửi email OTP thật (Gmail App Password). Để trống SMTP_USER thì OTP in ra log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Chỉ bật = 1 khi chạy script kiểm thử concurrency (API trả debug_otp), bình thường để 0
DEBUG_RETURN_OTP=0
