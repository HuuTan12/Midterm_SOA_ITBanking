# Copy file này thành .env rồi đổi các giá trị "changeme"
# Lệnh: Copy-Item .env.example .env
# Mật khẩu không nên có ký tự đặc biệt như @ / : vì được dùng trong URL kết nối

POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

JWT_SECRET=changeme
INTERNAL_API_KEY=changeme

# Gửi email OTP thật (Gmail App Password). Để trống SMTP_USER thì OTP in ra log
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
JWT_SECRET=ibanking_jwt_secret_key_2026_tdtu
INTERNAL_API_KEY=ibanking_internal_service_key_2026

# SMTP Gmail (để trống nếu muốn in mã OTP ra console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Chỉ bật = 1 khi chạy script kiểm thử concurrency, bình thường để 0
DEBUG_RETURN_OTP=0
# Đặt 1 để API trả về debug_otp khi test qua console/kịch bản test


